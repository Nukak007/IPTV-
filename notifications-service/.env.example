# ---------------------------------------------------------
# notifications-service — Template de variables de entorno
# Copia este archivo como .env y ajusta los valores
# ---------------------------------------------------------

NODE_ENV=development
PORT=3004

# SQLite (desarrollo):
DATABASE_URL="file:./dev.db"

# PostgreSQL (producción):
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/centavo_notifications?schema=public"

# Integración con budgets-service
BUDGETS_SERVICE_URL="http://localhost:3003"

# Umbral predeterminado de alerta (1.0 = 100% del presupuesto, 0.8 = 80%)
DEFAULT_ALERT_THRESHOLD=1.0
